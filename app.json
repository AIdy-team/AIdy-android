{
  "expo": {
    "name": "AIDY",
    "slug": "aidy-react-native",
    "scheme": "aidy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aidy.petrobot.rn",
      "infoPlist": {
        "NSCameraUsageDescription": "AR表示でカメラ映像の上にAidyを配置するために使います。",
        "NSMotionUsageDescription": "ARでカメラの傾きを使って机や床の位置を推定するために使います。",
        "NSPhotoLibraryAddUsageDescription": "作成したマーカー画像を写真に保存するために使います。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aidy.petrobot.rn",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "AR表示でカメラ映像の上にAidyを配置するために使います。"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "ARでカメラの傾きを使って机や床の位置を推定するために使います。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "作成したマーカー画像を写真に保存するために使います。",
          "savePhotosPermission": "作成したマーカー画像を写真に保存するために使います。"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["x86_64"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "55acfc5d-9b94-4315-be56-d82d6c72b23c"
      }
    },
    "owner": "mamama1213"
  }
}
